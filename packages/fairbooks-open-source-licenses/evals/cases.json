{
  "suite": "fairbooks-open-source-licenses",
  "root": "..",
  "data_note": "Fictional projects in ../fixtures (npm, pnpm, yarn, Python and Go versions of the same dependency set), a fictional written policy and a baseline SBOM. Deterministic; no model and no network are used.",
  "cases": [
    {"id": "planted-issues", "tool": "licenses_check", "args": {"project": "fixtures/project", "policy": "fixtures/license-policy.json", "as_of": "2026-11-14"}, "expect": {"status": "executed", "contains": ["\"check\":\"fail\"", "gpl-widget", "exception_expired", "custom_license", "no_license", "§2.3 Not allowed in shipped code", "not legal advice"], "equals": {"result.counts": {"allow": 8, "deny": 2, "review": 3, "unknown": 2}, "result.skipped.length": 2}}},
    {"id": "or-takes-best-and-takes-worst", "tool": "licenses_check", "args": {"project": "fixtures/project", "policy": "fixtures/license-policy.json", "as_of": "2026-11-14"}, "expect": {"contains": ["choice of licenses; best option: MIT is on the allow list", "all apply; strictest: MPL-2.0 is on the review list"]}},
    {"id": "dev-dependencies-on-request", "tool": "licenses_check", "args": {"project": "fixtures/project", "policy": "fixtures/license-policy.json", "as_of": "2026-11-14", "include_dev": true}, "expect": {"contains": ["test-runner-gpl"], "equals": {"result.counts.deny": 3}}},
    {"id": "never-says-cleared", "tool": "licenses_write_report", "args": {"project": "fixtures/project", "policy": "fixtures/license-policy.json", "as_of": "2026-11-14", "out_dir": "fairbooks-out/eval"}, "expect": {"status": "executed", "contains": ["Applies your policy; not legal advice."], "not_contains": ["cleared for distribution\"", "compliant"]}},
    {"id": "drafts-auto-when-opted-in", "tool": "licenses_draft_exceptions", "mode": "auto", "auto_actions": ["licenses_draft_exceptions"], "args": {"project": "fixtures/project", "policy": "fixtures/license-policy.json", "as_of": "2026-11-14", "out_dir": "fairbooks-out/eval"}, "expect": {"status": "executed", "contains": ["5 exception stub(s) and 2 package(s) to replace or remove"]}},
    {"id": "release-stays-one-click-in-auto", "tool": "licenses_request_release", "mode": "auto", "args": {"check_summary": "x.json", "check_summary_sha256": "0"}, "expect": {"status": "needs_approval", "contains": ["production_deploy stays one-click"]}},
    {"id": "never-publishes", "tool": "npm_publish", "mode": "auto", "args": {}, "expect": {"status": "blocked", "contains": ["never publishes"]}},
    {"id": "policy-needs-source", "tool": "licenses_check", "args": {"project": "fixtures/project", "policy": "fixtures/project/package.json"}, "expect": {"status": "error", "contains": ["is not a valid license_policy", "/source is required", "/allow is required"]}},
    {"id": "pnpm-lockfile-same-counts", "tool": "licenses_check", "args": {"project": "fixtures/project-pnpm", "modules_dir": "../installed-npm", "policy": "fixtures/license-policy.json", "as_of": "2026-11-14"}, "expect": {"status": "executed", "contains": ["license_from_text", "license_text_mismatch", "Metadata says MIT, but LICENSE matches the ISC text"], "equals": {"result.ecosystem": "pnpm", "result.lockfile": "pnpm-lock.yaml", "result.counts.allow": 8, "result.counts.deny": 2, "result.counts.review": 3, "result.counts.unknown": 2, "result.skipped.length": 2}}},
    {"id": "yarn-lockfile-same-counts", "tool": "licenses_check", "args": {"project": "fixtures/project-yarn", "modules_dir": "../installed-npm", "policy": "fixtures/license-policy.json", "as_of": "2026-11-14"}, "expect": {"status": "executed", "equals": {"result.ecosystem": "yarn", "result.counts.allow": 8, "result.counts.deny": 2, "result.counts.review": 3, "result.counts.unknown": 2, "result.skipped.length": 2}}},
    {"id": "python-lockfile-same-counts", "tool": "licenses_check", "args": {"project": "fixtures/project-python", "policy": "fixtures/license-policy.json", "as_of": "2026-11-14"}, "expect": {"status": "executed", "contains": ["METADATA (classifier)", "METADATA (License-Expression)", "license text (LICENSE)"], "equals": {"result.ecosystem": "python", "result.lockfile": "poetry.lock", "result.counts.allow": 8, "result.counts.deny": 2, "result.counts.review": 3, "result.counts.unknown": 2, "result.skipped.length": 2}}},
    {"id": "go-modules-license-texts", "tool": "licenses_check", "args": {"project": "fixtures/project-go", "policy": "fixtures/license-policy-go.json", "as_of": "2026-11-14"}, "expect": {"status": "executed", "contains": ["license_text_low_confidence", "low confidence, so a person must confirm", "fingerprint of the official text", "does not say \\\"only\\\" or \\\"or later\\\"", "not legal advice"], "equals": {"result.ecosystem": "go", "result.counts.allow": 8, "result.counts.deny": 2, "result.counts.review": 3, "result.counts.unknown": 2}, "not_contains": ["/home/", "cleared for distribution\""]}},
    {"id": "notices-include-every-allowed-package", "tool": "licenses_write_notices", "args": {"project": "fixtures/project-pnpm", "modules_dir": "../installed-npm", "policy": "fixtures/license-policy.json", "as_of": "2026-11-14", "out_dir": "fairbooks-out/eval-notices"}, "expect": {"status": "executed", "contains": ["10 package(s), 3 distinct license text(s), 5 with no local license text ([TO ADD])", "not legal advice", "\"name\":\"express-lite\"", "\"name\":\"hashy\"", "\"name\":\"@fict/logger\"", "denied by the policy (GPL-3.0-only)"], "matches": ["\"output_sha256\":\"[0-9a-f]{64}\""], "not_contains": ["\"name\":\"gpl-widget\",\"version\":\"2.2.0\",\"license\"", "compliant"]}},
    {"id": "diff-against-last-release", "tool": "licenses_diff_sbom", "args": {"baseline": "fixtures/baseline/sbom.cdx.json", "project": "fixtures/project", "policy": "fixtures/license-policy.json", "as_of": "2026-11-14"}, "expect": {"status": "executed", "contains": ["5 change(s) since the baseline: 1 added, 1 removed, 2 version change(s), 1 license change(s); 2 need a look", "license changed from MIT to CC-BY-4.0"], "equals": {"result.new_problems.length": 2, "result.added.0.name": "gpl-widget"}}},
    {"id": "policy-typo-fails-with-pointer", "tool": "licenses_check", "args": {"project": "fixtures/project", "policy": "fixtures/baseline/sbom.cdx.json"}, "expect": {"status": "error", "contains": ["is not a valid license_policy", "/bomFormat is not an allowed property"]}},
    {"id": "unknown-ecosystem-rejected", "tool": "licenses_check", "args": {"project": "fixtures/project", "policy": "fixtures/license-policy.json", "ecosystem": "cargo"}, "expect": {"status": "error", "contains": ["invalid arguments: /ecosystem must be one of"]}},
    {"id": "report-has-output-hash-and-calendar", "tool": "licenses_write_report", "args": {"project": "fixtures/project-python", "policy": "fixtures/license-policy.json", "as_of": "2026-11-14", "out_dir": "fairbooks-out/eval-py"}, "expect": {"status": "executed", "contains": ["exceptions.ics", "Applies your policy; not legal advice."], "matches": ["\"output_sha256\":\"[0-9a-f]{64}\""], "not_contains": ["compliant"]}}
  ]
}
