{
  "name": "fairbooks-refunds-and-chargebacks",
  "version": "0.2.1",
  "mcpName": "io.github.fpavia111-creator/fairbooks-refunds-and-chargebacks",
  "description": "Fairbooks Refunds and Chargebacks: an MCP agent that triages refund requests and chargebacks from CSV/JSON exports against your written policy and drafts dispute evidence packs. Issuing money is blocked; a refund request is one human click and only records a request.",
