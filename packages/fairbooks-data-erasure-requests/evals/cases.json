{
  "suite": "fairbooks-data-erasure-requests",
  "root": "..",
  "data_note": "Fictional people and exports in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {"id": "maps-personal-data", "tool": "erasure_map_data", "args": {"dir": "fixtures/exports"}, "expect": {"contains": ["\"category\":\"email\"", "\"category\":\"ip_address\"", "\"retention_flag\":true"]}},
    {"id": "finds-subject-everywhere", "tool": "erasure_find_subject", "args": {"dir": "fixtures/exports", "email": "Jamie.Doe@example.com", "phone": "512 555 0142", "ids": ["C-101"]}, "expect": {"equals": {"result.rows_found": 4, "result.files_with_data": 4}}},
    {"id": "identifiers-masked", "tool": "erasure_find_subject", "args": {"dir": "fixtures/exports", "email": "jamie.doe@example.com"}, "expect": {"contains": ["j***@example.com"], "not_contains": ["jamie.doe@example.com"]}},
    {"id": "checklist-due-date", "tool": "erasure_build_checklist", "args": {"dir": "fixtures/exports", "email": "jamie.doe@example.com", "received": "2026-11-10", "regime": "ccpa", "out_dir": "fairbooks-out/eval"}, "expect": {"equals": {"result.due": "2026-12-25"}}},
    {"id": "deletion-stays-one-click-in-auto", "tool": "erasure_request_deletion", "mode": "auto", "args": {"system": "CRM", "reason": "verified request"}, "expect": {"status": "needs_approval", "decision": "ask"}},
    {"id": "review-mode-blocks-deletion", "tool": "erasure_request_deletion", "mode": "review", "args": {"system": "CRM", "reason": "x"}, "expect": {"status": "blocked"}},
    {"id": "never-deletes", "tool": "erasure_delete_records", "mode": "auto", "args": {}, "expect": {"status": "blocked"}},
    {"id": "hashed-identifiers-match-without-raw", "tool": "erasure_find_subject", "args": {"dir": "fixtures/hashed", "email": "jamie.doe@example.com", "phone": "512-555-0142"}, "expect": {"equals": {"result.rows_found": 2, "result.rows_matched_by_hash": 2}, "contains": ["email_sha256", "email_md5", "phone_sha256"], "not_contains": ["jamie.doe@example.com", "5125550142"]}},
    {"id": "retention-hold-cited", "tool": "erasure_retention_check", "args": {"dir": "fixtures/exports", "email": "jamie.doe@example.com", "ids": ["C-101"], "rules": "fixtures/retention-rules.json", "as_of": "2026-11-15"}, "expect": {"equals": {"result.on_hold": 1, "result.retain_until": 1, "result.period_ended": 1}, "contains": ["HOLD-2026-07", "RET-INV-7Y", "2033-07-30"], "not_contains": ["jamie.doe@example.com"]}},
    {"id": "retention-rules-typo-rejected", "tool": "erasure_retention_check", "args": {"dir": "fixtures/exports", "ids": ["C-101"], "rules": "fixtures/exports/support-tickets.json"}, "expect": {"status": "error", "contains": ["not a valid retention_rules"]}},
    {"id": "deadlines-overdue-flagged", "tool": "erasure_deadlines", "args": {"log": "fixtures/requests-log.csv", "rules": "fixtures/retention-rules.json", "as_of": "2026-11-15", "ics": true, "out_dir": "fairbooks-out/eval"}, "expect": {"equals": {"result.overdue": 1, "result.due_soon": 1, "result.closed": 1}, "contains": ["request-deadlines.ics"]}},
    {"id": "evidence-pack-hash", "tool": "erasure_evidence_pack", "args": {"dir": "fixtures/exports", "email": "jamie.doe@example.com", "ids": ["C-101"], "rules": "fixtures/retention-rules.json", "as_of": "2026-11-15", "out_dir": "fairbooks-out/eval"}, "expect": {"status": "executed", "matches": ["\"output_sha256\":\"[0-9a-f]{64}\""], "contains": ["HOLD-2026-07"], "not_contains": ["jamie.doe@example.com"]}},
    {"id": "evidence-pack-allowed-in-review", "tool": "erasure_evidence_pack", "mode": "review", "args": {"dir": "fixtures/exports", "ids": ["C-100"], "as_of": "2026-11-15", "out_dir": "fairbooks-out/eval"}, "expect": {"status": "executed"}}
  ]
}
